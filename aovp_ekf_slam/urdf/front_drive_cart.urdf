<?xml version="1.0"?>
<robot name="front_drive_cart">
  <material name="green"><color rgba="0.10 0.75 0.25 1"/></material>
  <material name="black"><color rgba="0.06 0.06 0.06 1"/></material>
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.13"/><geometry><box size="0.62 0.42 0.20"/></geometry><material name="green"/></visual>
  </link>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <link name="front_left_wheel"><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.11" length="0.07"/></geometry><material name="black"/></visual></link>
  <link name="front_right_wheel"><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.11" length="0.07"/></geometry><material name="black"/></visual></link>
  <link name="rear_left_wheel"><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.11" length="0.07"/></geometry><material name="black"/></visual></link>
  <link name="rear_right_wheel"><visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.11" length="0.07"/></geometry><material name="black"/></visual></link>
  <joint name="front_left_wheel_joint" type="continuous"><origin xyz="0.23 0.25 0"/><parent link="base_link"/><child link="front_left_wheel"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><origin xyz="0.23 -0.25 0"/><parent link="base_link"/><child link="front_right_wheel"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_left_wheel_joint" type="continuous"><origin xyz="-0.23 0.25 0"/><parent link="base_link"/><child link="rear_left_wheel"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_right_wheel_joint" type="continuous"><origin xyz="-0.23 -0.25 0"/><parent link="base_link"/><child link="rear_right_wheel"/><axis xyz="0 1 0"/></joint>

  <link name="lidar_link"><visual><geometry><cylinder radius="0.065" length="0.07"/></geometry><material name="black"/></visual></link>
  <joint name="lidar_joint" type="fixed"><origin xyz="0.20 0 0.28"/><parent link="base_link"/><child link="lidar_link"/></joint>
</robot>
