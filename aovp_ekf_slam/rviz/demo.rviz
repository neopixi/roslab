Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 36; 42; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Color: 120; 120; 120
    - Class: rviz_default_plugins/RobotModel
      Name: Front-drive cart
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (Pixels): 2
      Style: Points
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Path
      Name: Wheel odometry path
      Enabled: true
      Topic:
        Value: /controller/odom_path
      Line Style: Lines
      Line Width: 0.03
      Color: 70; 145; 255
    - Class: rviz_default_plugins/Path
      Name: EKF-SLAM path
      Enabled: true
      Topic:
        Value: /slam/path
      Line Style: Lines
      Line Width: 0.06
      Color: 255; 65; 50
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: EKF robot pose
      Enabled: true
      Topic:
        Value: /slam/pose
      Shape:
        Color: 255; 80; 40
        Alpha: 1
      Covariance:
        Position:
          Alpha: 0.35
          Color: 255; 80; 40
        Orientation:
          Alpha: 0.35
    - Class: rviz_default_plugins/MarkerArray
      Name: EKF landmarks
      Enabled: true
      Topic:
        Value: /slam/landmarks
    - Class: rviz_default_plugins/Marker
      Name: Detour waypoints
      Enabled: true
      Topic:
        Value: /controller/waypoints
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Angle: 0
      Scale: 40
      X: 5
      Y: 0
Window Geometry:
  Width: 1280
  Height: 800
