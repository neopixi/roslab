<?xml version="1.0"?>
<sdf version="1.9">
  <world name="ekf_slam_demo">
    <physics name="fast_accurate" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.80 0.88 0.96 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><box><size>24 10 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 10 0.10</size></box></geometry>
          <material>
            <ambient>0.60 0.62 0.65 1</ambient>
            <diffuse>0.70 0.72 0.75 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>5 0 -0.05 0 0 0</pose>
    </model>

    <!-- Original straight path.  The cart returns to y=0 after the detour. -->
    <model name="route_line">
      <static>true</static>
      <pose>5.5 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>11 0.045 0.008</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.10 1</ambient>
            <diffuse>0.95 0.85 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Main obstacle: deliberately centered on the yellow route. -->
    <model name="obstacle">
      <static>true</static>
      <pose>4.0 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.70 0.95 0.90</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.95 0.90</size></box></geometry>
          <material><ambient>0.75 0.08 0.06 1</ambient><diffuse>0.90 0.10 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Circular landmarks are the anonymous features used by EKF-SLAM. -->
    <model name="landmark_1">
      <static>true</static><pose>1.45 1.35 0.28 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry><material><ambient>0.08 0.28 0.90 1</ambient><diffuse>0.10 0.40 1 1</diffuse></material></visual></link>
    </model>
    <model name="landmark_2">
      <static>true</static><pose>2.45 -1.45 0.28 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry><material><ambient>0.08 0.28 0.90 1</ambient><diffuse>0.10 0.40 1 1</diffuse></material></visual></link>
    </model>
    <model name="landmark_3">
      <static>true</static><pose>4.15 2.80 0.28 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry><material><ambient>0.08 0.28 0.90 1</ambient><diffuse>0.10 0.40 1 1</diffuse></material></visual></link>
    </model>
    <model name="landmark_4">
      <static>true</static><pose>5.60 -1.35 0.28 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry><material><ambient>0.08 0.28 0.90 1</ambient><diffuse>0.10 0.40 1 1</diffuse></material></visual></link>
    </model>
    <model name="landmark_5">
      <static>true</static><pose>7.20 1.40 0.28 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry><material><ambient>0.08 0.28 0.90 1</ambient><diffuse>0.10 0.40 1 1</diffuse></material></visual></link>
    </model>
    <model name="landmark_6">
      <static>true</static><pose>9.10 -1.50 0.28 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.56</length></cylinder></geometry><material><ambient>0.08 0.28 0.90 1</ambient><diffuse>0.10 0.40 1 1</diffuse></material></visual></link>
    </model>

    <model name="front_drive_cart" canonical_link="base_link">
      <pose>0 0 0.111 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>8.0</mass><inertia><ixx>0.18</ixx><iyy>0.32</iyy><izz>0.42</izz></inertia></inertial>
        <collision name="body_collision"><pose>0 0 0.13 0 0 0</pose><geometry><box><size>0.62 0.42 0.20</size></box></geometry></collision>
        <visual name="body_visual"><pose>0 0 0.13 0 0 0</pose><geometry><box><size>0.62 0.42 0.20</size></box></geometry>
          <material><ambient>0.08 0.55 0.18 1</ambient><diffuse>0.10 0.75 0.25 1</diffuse></material></visual>
      </link>

      <link name="front_left_wheel">
        <pose relative_to="base_link">0.23 0.25 0 1.5707963 0 0</pose>
        <inertial><mass>0.45</mass><inertia><ixx>0.0025</ixx><iyy>0.0025</iyy><izz>0.0045</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.35</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
      <link name="front_right_wheel">
        <pose relative_to="base_link">0.23 -0.25 0 1.5707963 0 0</pose>
        <inertial><mass>0.45</mass><inertia><ixx>0.0025</ixx><iyy>0.0025</iyy><izz>0.0045</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>0.35</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
      <link name="rear_left_wheel">
        <pose relative_to="base_link">-0.23 0.25 0 1.5707963 0 0</pose>
        <inertial><mass>0.35</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.004</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><surface><friction><ode><mu>0.18</mu><mu2>0.18</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
      <link name="rear_right_wheel">
        <pose relative_to="base_link">-0.23 -0.25 0 1.5707963 0 0</pose>
        <inertial><mass>0.35</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.004</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><surface><friction><ode><mu>0.18</mu><mu2>0.18</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.11</radius><length>0.07</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>

      <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>30</effort><velocity>30</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis></joint>
      <joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>30</effort><velocity>30</velocity></limit><dynamics><damping>0.05</damping></dynamics></axis></joint>
      <joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>30</velocity></limit><dynamics><damping>0.015</damping></dynamics></axis></joint>
      <joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>30</velocity></limit><dynamics><damping>0.015</damping></dynamics></axis></joint>

      <link name="lidar_link">
        <pose relative_to="base_link">0.20 0 0.28 0 0 0</pose>
        <inertial><mass>0.12</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
        <visual name="v"><geometry><cylinder><radius>0.065</radius><length>0.07</length></cylinder></geometry><material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
        <sensor name="lidar" type="gpu_lidar">
          <topic>scan</topic><gz_frame_id>lidar_link</gz_frame_id><update_rate>15</update_rate><always_on>true</always_on><visualize>true</visualize>
          <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-2.35619</min_angle><max_angle>2.35619</max_angle></horizontal></scan>
            <range><min>0.12</min><max>10.0</max><resolution>0.005</resolution></range>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.004</stddev></noise></lidar>
        </sensor>
      </link>
      <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

      <!-- Only the two FRONT joints are commanded. Rear wheels stay passive. -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <wheel_separation>0.50</wheel_separation><wheel_radius>0.11</wheel_radius>
        <topic>cmd_vel</topic><odom_topic>wheel/odom</odom_topic>
        <frame_id>wheel_odom</frame_id><child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>40</odom_publish_frequency>
        <max_linear_acceleration>1.2</max_linear_acceleration>
        <max_angular_acceleration>2.2</max_angular_acceleration>
      </plugin>
      <!-- Model-pose odometry closes the controller loop around real skid.
           EKF adds configurable encoder scale errors before prediction. -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>2</dimensions>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>odom</odom_topic>
        <odom_publish_frequency>40</odom_publish_frequency>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>front_left_wheel_joint</joint_name><joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name><joint_name>rear_right_wheel_joint</joint_name>
      </plugin>
    </model>
  </world>
</sdf>
